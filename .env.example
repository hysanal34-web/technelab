# ─────────────────────────────────────────
# TECHNE LAB — Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayın
# cp .env.example .env.local
# ─────────────────────────────────────────

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.technelabistanbul.com

# ── Ödeme (PayTR) ──────────────────────
# https://www.paytr.com
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt

# ── AI Görsel Üretimi (Fal.ai) ─────────
# https://fal.ai → Dashboard → API Keys
FAL_KEY=your_fal_api_key

# ── AI Görsel Düzenleme (Nano Banana) ──
# https://banana.dev → API Keys
BANANA_API_KEY=your_banana_api_key

# ── E-posta Outreach (Instantly.ai) ────
# https://instantly.ai (opsiyonel)
INSTANTLY_API_KEY=your_instantly_api_key

# ── Başvuru Formu E-postası (Gmail SMTP) ──
# Kurulum: Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
# "Mail" için 16 haneli uygulama şifresi oluştur, aşağıya yapıştır
GMAIL_USER=techne.lab.istanbul@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Bülten abone listesi — Resend panelinde Audiences bölümünden oluşturulur
RESEND_AUDIENCE_ID=

# Fiyat & bilgi formu lead listesi — Resend'de ayrı bir Audience oluştur ("Leads")
# Boşsa lead'ler RESEND_AUDIENCE_ID'ye, o da boşsa yalnızca maile düşer
RESEND_LEADS_AUDIENCE_ID=

# ── Meta (Facebook/Instagram) reklam takibi ──────────────────────
# Tarayıcı pikseli — Events Manager'daki piksel numarası
NEXT_PUBLIC_META_PIXEL_ID=1542440530516639
# Conversions API — sunucudan olay gönderimi (iOS/adblock kaybını kapatır)
META_PIXEL_ID=1542440530516639
# Events Manager → Ayarlar → Conversions API → "Erişim belirteci oluştur"
META_CAPI_ACCESS_TOKEN=
# Sadece kurulumu test ederken doldur, sonra sil (Test Events sekmesindeki kod)
META_TEST_EVENT_CODE=

# ── Google Ads dönüşüm takibi ────────────────────────────────────
# Ads → Hedefler → Dönüşümler → işleme tıkla → "Etkinlik snippet'ini göster"
# Oradaki send_to değeri "AW-XXXX/label" biçiminde; ikiye bölüp yaz.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18404939896
NEXT_PUBLIC_ADS_LABEL_BASVURU=8jFPCMz71-kcEPiwlMhE
