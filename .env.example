# ─────────────────────────────────────────
# TECHNE LAB — Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayın
# cp .env.example .env.local
# ─────────────────────────────────────────

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.technelabistanbul.com

# ── Ödeme (PayTR) ──────────────────────
# https://www.paytr.com
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt

# ── AI Görsel Üretimi (Fal.ai) ─────────
# https://fal.ai → Dashboard → API Keys
FAL_KEY=your_fal_api_key

# ── AI Görsel Düzenleme (Nano Banana) ──
# https://banana.dev → API Keys
BANANA_API_KEY=your_banana_api_key

# ── E-posta Outreach (Instantly.ai) ────
# https://instantly.ai (opsiyonel)
INSTANTLY_API_KEY=your_instantly_api_key

# ── Başvuru Formu E-postası (Gmail SMTP) ──
# Kurulum: Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
# "Mail" için 16 haneli uygulama şifresi oluştur, aşağıya yapıştır
GMAIL_USER=techne.lab.istanbul@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Bülten abone listesi — Resend panelinde Audiences bölümünden oluşturulur
RESEND_AUDIENCE_ID=

# Fiyat & bilgi formu lead listesi — Resend'de ayrı bir Audience oluştur ("Leads")
# Boşsa lead'ler RESEND_AUDIENCE_ID'ye, o da boşsa yalnızca maile düşer
RESEND_LEADS_AUDIENCE_ID=

# ── Meta (Facebook/Instagram) reklam takibi ──────────────────────
# Ayrıntı ve olay sözlüğü: docs/olcum/META-OLCUM.md
# Tarayıcı pikseli — Events Manager'daki piksel (veri kümesi) numarası.
# Piksel yalnızca çerez banner'ında "pazarlama" izni verilince yüklenir.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API — sunucudan olay gönderimi. SADECE sunucu değişkenleri:
# NEXT_PUBLIC_ öneki ALMAZ, tarayıcıya ve repoya çıkmaz.
META_PIXEL_ID=
# Events Manager → Veri kümesi → Ayarlar → Conversions API → "Erişim belirteci oluştur"
META_CAPI_ACCESS_TOKEN=
# Yalnızca kurulumu Test Events'te doğrularken doldur, sonra SİL.
# Doluyken sunucu olayları gerçek raporlara gitmez.
META_TEST_EVENT_CODE=
# 1 → Meta'ya hiçbir şey gönderme, yalnızca hangi alanların gideceğini logla (yerel deneme).
META_CAPI_KURU=

# ── Ölçüm deposu ve tekil sayım ──────────────────────────────────
# Dönüşüm/tıklama kayıtları başvurularla aynı Blob deposuna (olcum/ öneki) yazılır.
# BLOB_READ_WRITE_TOKEN zaten tanımlı olmalı.
# Kişi ve ziyaretçi kimliklerini geri döndürülemez özetlemek için gizli anahtar.
# Boşsa ADMIN_SESSION_SECRET kullanılır. Değiştirilirse eski kayıtlarla tekil
# eşleşme kopar (sayılar bozulmaz, yalnızca tekil birleştirme sıfırlanır).
# Üretmek için: openssl rand -hex 32
OLCUM_ANAHTARI=

# ── Google etiketi izin modu ─────────────────────────────────────
# temel (varsayılan): izin verilene kadar Google etiketi hiç yüklenmez.
# gelismis: etiket yüklenir, izin yokken Consent Mode "denied" ile çerezsiz çalışır.
NEXT_PUBLIC_GOOGLE_IZIN_MODU=temel

# ── WhatsApp Business Platform (Cloud API) webhook — opsiyonel ───
# İkisi de tanımlanmadıkça /api/whatsapp/webhook 404 döner ve panel WhatsApp
# görüşme sayılarını "Entegrasyon gerekli" gösterir.
# Kendi belirlediğin rastgele metin; Meta uygulama panelinde aynısını yaz.
WHATSAPP_VERIFY_TOKEN=
# Meta uygulaması → Ayarlar → Temel → Uygulama gizli anahtarı (App Secret)
WHATSAPP_APP_SECRET=

# ── Google Ads dönüşüm takibi ────────────────────────────────────
# Ads → Hedefler → Dönüşümler → işleme tıkla → "Etkinlik snippet'ini göster"
# Oradaki send_to değeri "AW-XXXX/label" biçiminde; ikiye bölüp yaz.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18404939896
NEXT_PUBLIC_ADS_LABEL_BASVURU=8jFPCMz71-kcEPiwlMhE
# Tanışma günü kaydı için AYRI bir dönüşüm işlemi oluştur ("Tanışma Günü Kaydı"),
# etiketini buraya yaz. Ücretsiz tanışma kaydıyla ücretli program başvurusu aynı
# etikete yazılırsa ne ayrı raporlanabiliyor ne ayrı optimize edilebiliyor.
# Boş bırakılırsa yukarıdaki başvuru etiketine düşer (ölçüm kaybolmaz).
NEXT_PUBLIC_ADS_LABEL_TANISMA=

# ── Yönetim paneli (/admin) ─────────────────────────────────────────
# Paneli açan tek ortak şifre. Tanımlı değilse panel hiç açılmaz.
ADMIN_PASSWORD=
# Oturum çerezinin imza anahtarı. Boş bırakılırsa ADMIN_PASSWORD kullanılır
# (o zaman şifre değişince tüm oturumlar düşer, istenen davranış budur).
ADMIN_SESSION_SECRET=

# ── Başvuru deposu (Vercel Blob) ────────────────────────────────────
# `vercel storage connect technelab-basvuru` ile kendiliğinden gelir.
# Tanımlı değilse formlar çalışmaya devam eder, yalnız panelde liste boş olur.
BLOB_READ_WRITE_TOKEN=
